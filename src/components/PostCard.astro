---
import { SHAPES, FORMAT_COLOR } from '../consts.js';
import { UI, LOCALE_TAG } from '../i18n.js';
import { postUrl } from '../posts.js';
import Placeholder from './Placeholder.astro';

const { post } = Astro.props;
const d = post.data;
const t = UI[post.lang];
const shape = SHAPES[d.ratio] || SHAPES.photo;
const fecha = new Date(d.date).toLocaleDateString(LOCALE_TAG[post.lang], { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class="card" data-format={d.format}>
  <a href={postUrl(post)}>
    <div class="frame">
      {d.cover
        ? <img src={d.cover} alt={d.title} style={'aspect-ratio:' + shape.ratio} />
        : <Placeholder ratio={shape.ratio} text={t.formats[d.format] + ' ' + shape.label} />}
      <span class="size">{shape.label}</span>
    </div>
    <div class="meta">
      <div class="tags">
        <span class="fmt" style={'background:' + FORMAT_COLOR[d.format]}>{t.formats[d.format]}</span>
        <span class="lvl">{t.levels[d.level]}</span>
      </div>
      <h3>{d.title}</h3>
      <p>{d.description}</p>
      <div class="foot">{fecha} &middot; {d.minutes} {t.readTime}</div>
    </div>
  </a>
</article>
<style>
  .card { break-inside: avoid; margin-bottom: 26px; background: #fff; border: 1.5px solid #14171c; }
  .card:hover { box-shadow: 7px 7px 0 #ded8ca; }
  a { display: block; color: inherit; text-decoration: none; }
  .frame { padding: 12px; position: relative; }
  .frame img { width: 100%; display: block; object-fit: contain; }
  .size { position: absolute; top: 22px; right: 22px; font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.1em; background: #14171c; color: #f2efe9; padding: 3px 8px; }
  .meta { padding: 4px 18px 20px; display: flex; flex-direction: column; gap: 9px; }
  .tags { display: flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; }
  .fmt { color: #fff; padding: 3px 9px; }
  .lvl { color: #85806f; }
  h3 { font-size: 20px; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; margin: 0; text-wrap: pretty; }
  p { font-size: 14px; line-height: 1.6; color: #55524a; margin: 0; font-weight: 300; }
  .foot { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #85806f; }
</style>
