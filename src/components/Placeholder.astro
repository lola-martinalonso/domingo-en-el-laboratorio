---
const { ratio, text } = Astro.props;
---
<div class="ph" style={'aspect-ratio:' + ratio}><span>{text}</span></div>
<style>
  .ph {
    border: 1px dashed #c3bcaa;
    background: #fbfaf7;
    background-image: repeating-linear-gradient(135deg, #eee9dd 0 7px, #fbfaf7 7px 14px);
    display: flex; align-items: center; justify-content: center;
  }
  span {
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #8a8578;
    background: #fbfaf7; padding: 6px 10px; text-align: center;
  }
</style>
