---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts } from '../../posts.js';
import { UI, EMAIL } from '../../i18n.js';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const t = UI[lang];
const posts = allPosts(lang);
const cats = ['all', 'comic', 'infographic', 'article'];
---
<Base title={'Domingo en el laboratorio'} description={t.heroBody} lang={lang}>
  <section class="wrap hero">
    <div class="kicker">{t.collKicker}</div>
    <h1>{t.heroTitle}</h1>
    <p class="lede">{t.heroBody}</p>
  </section>

  <section class="wrap" id="entradas">
    <div class="bar">
      <div class="filters">
        {cats.map((c, i) => (
          <button class={i === 0 ? 'chip on' : 'chip'} data-filter={c}>{c === 'all' ? t.all : t.formats[c]}</button>
        ))}
      </div>
      <div class="count mono">{posts.length}</div>
    </div>

    {posts.length === 0 && <p class="lede">{t.empty}</p>}
    <div class="masonry">
      {posts.map(p => <PostCard post={p} />)}
    </div>
  </section>

  <section class="wrap">
    <div class="band">
      <div>
        <div class="kicker">{t.aboutTitle}</div>
        <p class="big">{t.aboutBody}</p>
      </div>
      <div class="acts">
        <a class="btn solid" href={'/' + lang + '/sobre/'}>{t.aboutCta}</a>
        <a class="btn line" href={'mailto:' + EMAIL}>{t.workCta}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-filter]').forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach(function (x) { x.classList.toggle('on', x === b); });
        document.querySelectorAll('.masonry .card').forEach(function (c) {
          c.style.display = (f === 'all' || c.dataset.format === f) ? '' : 'none';
        });
      });
    });
  </script>
</Base>

<style>
  .hero { padding-top: 44px; padding-bottom: 8px; max-width: 900px; margin: 0; }
  .kicker { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent); }
  h1 { font-size: 72px; line-height: 0.98; letter-spacing: -0.045em; font-weight: 600;
    margin: 20px 0 0; text-wrap: balance; }
  .lede { font-size: 19px; line-height: 1.6; color: var(--muted); max-width: 56ch;
    margin: 24px 0 0; font-weight: 300; text-wrap: pretty; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px;
    flex-wrap: wrap; margin-top: 64px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip { background: transparent; color: var(--muted); border: 1px solid var(--line);
    padding: 9px 18px; border-radius: 999px; cursor: pointer; font-family: 'IBM Plex Mono', monospace;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; transition: all 0.18s ease; }
  .chip:hover { color: #fff; border-color: var(--accent); }
  .chip.on { background: var(--accent); color: var(--ink); border-color: var(--accent); }
  .count { font-size: 10px; letter-spacing: 0.2em; color: var(--faint); }
  .masonry { column-count: 3; column-gap: 40px; margin-top: 44px; }
  .band { display: flex; align-items: center; justify-content: space-between; gap: 40px;
    flex-wrap: wrap; border-top: 1px solid var(--line); margin-top: 44px; padding-top: 44px; }
  .big { font-size: 30px; line-height: 1.3; letter-spacing: -0.025em; margin: 16px 0 0;
    max-width: 34ch; font-weight: 400; text-wrap: pretty; }
  .acts { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { padding: 14px 26px; border-radius: 999px; font-size: 15px; font-weight: 500; }
  .btn.solid { background: var(--accent); color: var(--ink); }
  .btn.solid:hover { background: #fff; }
  .btn.line { border: 1px solid var(--line); color: var(--paper); }
  .btn.line:hover { border-color: var(--accent); color: #fff; }
  @media (max-width: 1050px) { .masonry { column-count: 2; } h1 { font-size: 52px; } }
  @media (max-width: 640px) { .masonry { column-count: 1; } h1 { font-size: 38px; } .big { font-size: 24px; } }
</style>
