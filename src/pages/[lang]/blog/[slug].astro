---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Placeholder from '../../../components/Placeholder.astro';
import { allPosts } from '../../../posts.js';
import { UI, LOCALE_TAG } from '../../../i18n.js';
import { SHAPES } from '../../../consts.js';

export function getStaticPaths() {
  return allPosts().map(p => ({ params: { lang: p.lang, slug: p.slug }, props: { post: p } }));
}

const { lang } = Astro.params;
const { post } = Astro.props;
const d = post.data;
const t = UI[lang];
const Content = post.Content;
const shape = SHAPES[d.ratio] || SHAPES.photo;
const fmt = (v) => new Date(v).toLocaleDateString(LOCALE_TAG[lang], { day: 'numeric', month: 'long', year: 'numeric' });
const more = allPosts(lang).filter(p => p.slug !== post.slug).slice(0, 3);
---
<Base title={d.title} description={d.description} lang={lang}>
  <div class="wrap back"><a href={'/' + lang + '/#entradas'}>&larr; {t.backAll}</a></div>

  <article>
    <div class="head">
      <div class="tags">
        <span class="fmt">{t.formats[d.format]}</span>
        <span class="tag">{t.levels[d.level]}</span>
        {(d.tags || []).map(tag => <span class="tag">{tag}</span>)}
        <span class="tag">{shape.label}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <div class="byline">
        Lola Martin Alonso &middot; {fmt(d.date)} &middot; {d.minutes} {t.readTime}
        {d.updated && <span> &middot; {t.updated} {fmt(d.updated)}</span>}
      </div>
    </div>

    <div class="stage-wrap">
      <div class="toolbar">
        {d.pdf
          ? <div class="seg">
              <button class="on" data-mode="page">{t.modePage}</button>
              <button data-mode="panel">{t.modePanel}</button>
            </div>
          : <span></span>}
        <div class="dl">
          {d.pdf && <a class="btn line" href={d.pdf} download>{t.dlPdf}</a>}
          {d.cover && <a class="btn line" href={d.cover} download>{t.dlPng}</a>}
        </div>
      </div>

      <div class="stage">
        {d.pdf
          ? <div class="pdfdoc loading" id="doc" data-pdf={d.pdf} style={'aspect-ratio:' + shape.ratio}></div>
          : d.cover
            ? <img class="single" src={d.cover} alt={d.title} />
            : <Placeholder ratio={shape.ratio} text={t.formats[d.format] + ' ' + shape.label} />}
      </div>
    </div>

    <div class="body"><Content /></div>

    {d.pdf && (
      <div class="classroom">
        <div><strong>{t.classTitle}</strong><span>{t.classBody}</span></div>
        <a class="btn warm" href={d.pdf} download>{t.classCta}</a>
      </div>
    )}

    <div class="wrap more">
      <div class="kicker">{t.moreKicker}</div>
      <div class="grid">{more.map(p => <PostCard post={p} />)}</div>
    </div>
  </article>

  <script is:inline>
    document.querySelectorAll('[data-mode]').forEach(function (b) {
      b.addEventListener('click', function () {
        var doc = document.getElementById('doc');
        if (!doc) return;
        document.querySelectorAll('[data-mode]').forEach(function (x) { x.classList.toggle('on', x === b); });
        doc.classList.toggle('row', b.dataset.mode === 'panel');
      });
    });
  </script>
</Base>

<style>
  .back { padding-top: 6px; padding-bottom: 22px; font-family: 'IBM Plex Mono', monospace;
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; }
  .head { max-width: 780px; margin: 0 auto; padding: 28px 36px 0; }
  .tags { display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
    font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; }
  .fmt { color: var(--warm); }
  .tag { color: var(--faint); }
  h1 { font-size: 56px; line-height: 1.02; letter-spacing: -0.042em; font-weight: 600;
    margin: 22px 0 0; text-wrap: balance; }
  .lede { font-size: 20px; line-height: 1.6; color: var(--muted); font-weight: 300;
    margin: 20px 0 0; max-width: 54ch; text-wrap: pretty; }
  .byline { margin-top: 26px; font-family: 'IBM Plex Mono', monospace; font-size: 10px;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .stage-wrap { max-width: 1000px; margin: 44px auto 0; padding: 0 36px; }
  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px;
    flex-wrap: wrap; margin-bottom: 18px; }
  .seg { display: flex; gap: 4px; border: 1px solid var(--line); border-radius: 999px; padding: 3px; }
  .seg button { background: transparent; border: none; padding: 9px 18px; border-radius: 999px;
    cursor: pointer; font-family: inherit; font-size: 13px; font-weight: 500; color: var(--muted); }
  .seg button.on { background: var(--accent); color: var(--ink); }
  .dl { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn { padding: 11px 20px; border-radius: 999px; font-size: 13px; font-weight: 500; }
  .btn.line { border: 1px solid var(--line); color: var(--paper); }
  .btn.line:hover { border-color: var(--accent); color: #fff; }
  .btn.warm { background: var(--warm); color: #2a1f08; padding: 14px 26px; font-size: 14px; font-weight: 600; }
  .btn.warm:hover { background: #f0b653; color: #2a1f08; }
  .single { display: block; width: 100%; filter: drop-shadow(var(--shadow)); }
  .body { max-width: 680px; margin: 0 auto; padding: 64px 36px 0; font-size: 18px;
    line-height: 1.8; color: var(--paper); font-weight: 300; }
  .body :global(p) { margin: 24px 0; text-wrap: pretty; }
  .body :global(h2) { font-size: 30px; font-weight: 600; letter-spacing: -0.028em;
    margin: 56px 0 0; line-height: 1.15; }
  .body :global(h3) { font-size: 22px; font-weight: 600; margin: 40px 0 0; }
  .body :global(strong) { font-weight: 600; color: #fff; }
  .body :global(em) { color: var(--accent); font-style: italic; }
  .body :global(ul), .body :global(ol) { padding-left: 22px; }
  .body :global(li) { margin: 12px 0; }
  .body :global(blockquote) { margin: 44px 0; padding: 4px 0 4px 26px;
    border-left: 2px solid var(--warm); font-size: 22px; line-height: 1.45;
    color: #fff; font-weight: 400; letter-spacing: -0.015em; }
  .body :global(blockquote p) { margin: 0; }
  .body :global(a) { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px;
    text-underline-offset: 3px; }
  .body :global(img) { display: block; margin: 36px auto; filter: drop-shadow(var(--shadow)); }
  .body :global(h2 + p) { margin-top: 16px; }
  .classroom { max-width: 680px; margin: 56px auto 0; padding: 30px 34px;
    border: 1px solid var(--line); border-radius: 4px; display: flex; align-items: center;
    justify-content: space-between; gap: 22px; flex-wrap: wrap; }
  .classroom strong { display: block; font-size: 19px; }
  .classroom span { display: block; font-size: 14px; color: var(--muted); margin-top: 6px;
    font-weight: 300; }
  .more { margin-top: 88px; }
  .kicker { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 28px;
    align-items: start; }
  @media (max-width: 1000px) { h1 { font-size: 40px; } .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .head, .body, .stage-wrap { padding-left: 20px; padding-right: 20px; }
    h1 { font-size: 32px; } .grid { grid-template-columns: 1fr; }
  }
</style>
