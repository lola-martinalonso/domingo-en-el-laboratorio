---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Placeholder from '../../../components/Placeholder.astro';
import { allPosts, postUrl } from '../../../posts.js';
import { UI, LOCALE_TAG } from '../../../i18n.js';
import { SHAPES } from '../../../consts.js';

export function getStaticPaths() {
  return allPosts().map(p => ({ params: { lang: p.lang, slug: p.slug }, props: { post: p } }));
}

const { lang } = Astro.params;
const { post } = Astro.props;
const d = post.data;
const t = UI[lang];
const Content = post.Content;
const shape = SHAPES[d.ratio] || SHAPES.photo;
const fecha = new Date(d.date).toLocaleDateString(LOCALE_TAG[lang], { day: 'numeric', month: 'long', year: 'numeric' });
const more = allPosts(lang).filter(p => p.slug !== post.slug).slice(0, 3);
const panels = d.panels || [];
---
<Base title={d.title} description={d.description} lang={lang}>
  <div class="wrap back"><a href={'/' + lang + '/#entradas'}>&larr; {t.backAll}</a></div>

  <article>
    <div class="head">
      <div class="tags">
        <span class="fmt">{t.formats[d.format]}</span>
        {(d.tags || []).map(tag => <span class="tag">{tag}</span>)}
        <span class="tag">{shape.label}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <div class="byline">Lola Martin Alonso &middot; {fecha} &middot; {d.minutes} {t.readTime}</div>
    </div>

    <div class="stage-wrap">
      <div class="toolbar">
        {panels.length > 0 && (
          <div class="seg">
            <button class="on" data-mode="page">{t.modePage}</button>
            <button data-mode="panel">{t.modePanel}</button>
          </div>
        )}
        <div class="dl">
          {d.pdf && <a class="btn line" href={d.pdf} download>{t.dlPdf}</a>}
          {d.cover && <a class="btn line" href={d.cover} download>{t.dlPng}</a>}
        </div>
      </div>

      <div class="stage" id="stage-page">
        {d.cover
          ? <img src={d.cover} alt={d.title} />
          : <Placeholder ratio={shape.ratio} text={t.formats[d.format] + ' ' + shape.label} />}
      </div>

      {panels.length > 0 && (
        <div class="stage panels" id="stage-panel" hidden>
          {panels.map((src, i) => <img src={src} alt={'panel ' + (i + 1)} />)}
        </div>
      )}
    </div>

    <div class="body"><Content /></div>

    {d.pdf && (
      <div class="classroom">
        <div><strong>{t.classTitle}</strong><span>{t.classBody}</span></div>
        <a class="btn dark" href={d.pdf} download>{t.classCta}</a>
      </div>
    )}

    <div class="wrap more">
      <div class="kicker">{t.moreKicker}</div>
      <div class="grid">{more.map(p => <PostCard post={p} />)}</div>
    </div>
  </article>

  <script is:inline>
    document.querySelectorAll('[data-mode]').forEach(function (b) {
      b.addEventListener('click', function () {
        var m = b.dataset.mode;
        document.querySelectorAll('[data-mode]').forEach(function (x) { x.classList.toggle('on', x === b); });
        document.getElementById('stage-page').hidden = m !== 'page';
        var p = document.getElementById('stage-panel');
        if (p) p.hidden = m !== 'panel';
      });
    });
  </script>
</Base>

<style>
  .back { padding-top: 8px; padding-bottom: 20px; border-bottom: 1.5px solid var(--ink); font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; }
  .head { max-width: 760px; margin: 0 auto; padding: 44px 36px 0; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; }
  .fmt { background: var(--red); color: #fff; padding: 5px 11px; }
  .tag { border: 1px solid var(--ink); padding: 5px 11px; }
  h1 { font-size: 56px; line-height: 1.03; letter-spacing: -0.04em; font-weight: 600; margin: 22px 0 0; text-wrap: balance; }
  .lede { font-size: 20px; line-height: 1.6; color: var(--grey); font-weight: 300; margin: 18px 0 0; max-width: 54ch; text-wrap: pretty; }
  .byline { margin-top: 24px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .stage-wrap { max-width: 1180px; margin: 40px auto 0; padding: 0 36px; }
  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
  .seg { display: flex; gap: 6px; border: 1.5px solid var(--ink); border-radius: 999px; padding: 3px; }
  .seg button { background: transparent; border: none; padding: 9px 16px; border-radius: 999px; cursor: pointer; font-family: inherit; font-size: 13px; font-weight: 500; color: var(--grey); }
  .seg button.on { background: var(--ink); color: var(--paper); }
  .dl { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn { padding: 10px 18px; border-radius: 999px; font-size: 13px; font-weight: 500; }
  .btn.line { border: 1.5px solid var(--ink); color: var(--ink); }
  .btn.dark { background: var(--ink); color: var(--paper); padding: 13px 24px; font-size: 14px; font-weight: 600; }
  .stage { background: #fff; border: 1.5px solid var(--ink); padding: 22px; box-shadow: 10px 10px 0 #ded8ca; }
  .stage img { display: block; width: 100%; }
  .panels { display: flex; gap: 16px; overflow-x: auto; box-shadow: none; }
  .panels img { flex: 0 0 min(80vw, 420px); width: auto; }
  .body { max-width: 660px; margin: 0 auto; padding: 56px 36px 0; font-size: 18px; line-height: 1.75; color: #33312c; font-weight: 300; }
  .body h2 { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); margin: 44px 0 16px; }
  .body blockquote { margin: 40px 0; padding: 22px 26px; border-left: 3px solid var(--red); background: #fff; font-size: 20px; line-height: 1.55; color: var(--ink); }
  .body img { display: block; margin: 32px auto; border: 1.5px solid var(--ink); }
  .classroom { max-width: 660px; margin: 48px auto 0; padding: 30px 36px; background: var(--yellow); border: 1.5px solid var(--ink); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .classroom strong { display: block; font-size: 20px; }
  .classroom span { display: block; font-size: 14px; color: #3d3524; margin-top: 6px; }
  .more { margin-top: 72px; }
  .kicker { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 20px; align-items: start; }
  @media (max-width: 1000px) { h1 { font-size: 40px; } .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .head, .body, .stage-wrap { padding-left: 20px; padding-right: 20px; } h1 { font-size: 32px; } .grid { grid-template-columns: 1fr; } }
</style>
