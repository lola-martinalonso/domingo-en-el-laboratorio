---
import { UI, EMAIL, TWITTER, LINKEDIN } from '../i18n.js';
const { title, description, lang } = Astro.props;
const t = UI[lang];
const other = lang === 'es' ? 'en' : 'es';
const otherHref = Astro.url.pathname.replace('/' + lang, '/' + other);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#1b3a6b" />
  <link rel="alternate" hreflang={other} href={otherHref} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site">
    <a class="brand" href={'/' + lang + '/'}>
      <strong>Domingo en el laboratorio</strong>
      <small>{t.tagline} &middot; Lola Martin Alonso</small>
    </a>
    <nav>
      <a href={'/' + lang + '/#entradas'}>{t.navPosts}</a>
      <a href={'/' + lang + '/sobre/'}>{t.navAbout}</a>
      <a class="cta" href={'mailto:' + EMAIL}>{t.navContact}</a>
      <span class="lang">
        <a href={lang === 'es' ? Astro.url.pathname : otherHref} class={lang === 'es' ? 'on' : ''}>ES</a>
        <a href={lang === 'en' ? Astro.url.pathname : otherHref} class={lang === 'en' ? 'on' : ''}>EN</a>
      </span>
    </nav>
  </header>

  <slot />

  <footer class="site">
    <span>Domingo en el laboratorio &middot; Lola Martin Alonso</span>
    <span class="links">
      <a href={TWITTER} rel="me">Twitter</a>
      <a href={LINKEDIN} rel="me">LinkedIn</a>
      <a href={'mailto:' + EMAIL}>Email</a>
    </span>
  </footer>

  <script is:inline type="module" src="/comic.js"></script>

  <style is:global>
    :root {
      --bg: #1b3a6b; --deep: #142c53; --ink: #0d1e3b;
      --paper: #eef2f8; --muted: #a3b6d4; --faint: #7f95b8;
      --accent: #c8d4e8; --warm: #e0a33c;
      --shadow: 0 22px 54px rgba(6,16,36,0.55);
      --line: rgba(200,212,232,0.22);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--paper);
           font-family: 'IBM Plex Sans', system-ui, sans-serif;
           -webkit-font-smoothing: antialiased; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: #fff; }
    img { max-width: 100%; }
    .wrap { max-width: 1300px; margin: 0 auto; padding: 0 36px; }
    .mono { font-family: 'IBM Plex Mono', monospace; }

    header.site, footer.site { max-width: 1300px; margin: 0 auto; padding: 28px 36px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    footer.site { border-top: 1px solid var(--line); margin-top: 96px; padding-bottom: 56px;
      font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--faint); }
    footer.site .links { display: flex; gap: 20px; }
    .brand { color: inherit; display: block; }
    .brand strong { display: block; font-size: 17px; letter-spacing: -0.015em; color: var(--paper); }
    .brand small { display: block; font-family: 'IBM Plex Mono', monospace; font-size: 10px;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); margin-top: 5px; }
    header.site nav { display: flex; align-items: center; gap: 22px; font-size: 14px; }
    header.site nav a { color: var(--muted); }
    header.site nav a:hover { color: #fff; }
    header.site nav a.cta { color: var(--ink); background: var(--accent); padding: 9px 18px;
      border-radius: 999px; font-size: 13px; font-weight: 500; }
    header.site nav a.cta:hover { background: #fff; }
    .lang { display: flex; gap: 2px; border: 1px solid var(--line); border-radius: 999px; padding: 2px; }
    .lang a { font-family: 'IBM Plex Mono', monospace; font-size: 11px; padding: 6px 12px;
      border-radius: 999px; color: var(--muted); }
    .lang a.on { background: var(--accent); color: var(--ink); }

    .pdfdoc { display: grid; gap: 22px; }
    .pdfdoc.loading { background: rgba(255,255,255,0.04); border: 1px dashed var(--line); }
    .pdfdoc .pdfpage { filter: drop-shadow(var(--shadow)); }
    .pdfdoc .pdfpage canvas { display: block; width: 100%; height: auto; }
    .pdfdoc.failed::after { content: 'PDF'; }
    .pdfdoc.row { grid-auto-flow: column; grid-auto-columns: min(84vw, 460px);
      overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; }
    .pdfdoc.row .pdfpage { scroll-snap-align: center; }

    @media (max-width: 800px) {
      .wrap, header.site, footer.site { padding-left: 20px; padding-right: 20px; }
      header.site nav { gap: 16px; font-size: 13px; width: 100%; }
    }
  </style>
</body>
</html>
